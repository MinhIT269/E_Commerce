@using E_Commerce.UI.Models.Responses
@model List<ProductResponseDto>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col-6 col-sm-4 col-md-3 col-xl-5col">
            <div class="product-default">
                <figure>
                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductId })">
                        <img src="@item.ImageUrl" width="220" height="220" alt="@item.Name" style="width:220px; height: 220px;" />
                        <img src="@item.ImageUrl" width="220" height="220" alt="@item.Name" />
                    </a>

                    <div class="label-group">
                        @if (item.PromotionPrice.HasValue && item.PromotionPrice > item.Price)
                        {
                            var discount = Math.Round((1 - (item.Price / item.PromotionPrice.Value)) * 100);
                            <div class="product-label label-sale">-@discount%</div>
                        }
                    </div>
                </figure>

                <div class="product-details">
                    <div class="category-wrap">
                        <div class="category-list">
                            <a href="#" class="product-category">Category</a>
                        </div>
                    </div>

                    <h3 class="product-title">
                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductId })">@item.Name</a>
                    </h3>

                    <div class="ratings-container">
                        <div class="product-ratings">
                            <span class="ratings" style="width:100%"></span>
                            <span class="tooltiptext tooltip-top"></span>
                        </div>
                    </div>


                    <div class="price-box">
                        @{
                            var price = item.Price;
                            var promo = item.PromotionPrice ?? 0m;
                        }

                        @if (promo > 0 && promo < price)
                        {
                            <span class="old-price text-muted">@price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</span>
                            <div class="product-price text-danger mt-1">@promo.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</div>
                        }
                        else if (promo > 0)
                        {
                            <span class="old-price text-muted"></span>
                            <div class="product-price text-danger mt-1">@promo.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</div>
                        }
                        else if (price > 0)
                        {
                            <span class="old-price text-muted"></span>
                            <div class="product-price text-danger mt-1">@price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</div>
                        }
                        else
                        {
                            <span class="old-price text-muted"></span>
                            <div class="product-price text-danger mt-1">Giá: Liên hệ</div>
                        }
                    </div>
                    <div class="product-action">
                        <a href="#" class="btn-icon-wish" title="wishlist">
                            <i class="icon-heart"></i>
                        </a>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductId })"
                           class="btn-icon btn-add-cart product-type-simple"
                           onclick="event.stopPropagation();">
                            <i class="icon-shopping-cart"></i><span>XEM CHI TIẾT</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>Không có sản phẩm nào phù hợp.</p>
}
<!-- End .col-sm-4 -->
