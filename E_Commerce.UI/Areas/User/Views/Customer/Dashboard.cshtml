							</h3>
							<div class="change-password">
								<form id="change-password-form">
									<div class="form-group">
										<label for="acc-password" class="font-weight-bold">Mật khẩu hiện tại <span class="required">*</span></label>
										<input type="password" class="form-control" id="acc-password" name="CurrentPassword" placeholder="Nhập mật khẩu hiện tại" required />
									</div>

									<div class="form-group">
										<label for="acc-new-password" class="font-weight-bold">Mật khẩu mới <span class="required">*</span></label>
										<input type="password" class="form-control" id="acc-new-password" name="NewPassword" placeholder="Tối thiểu 6 ký tự" minlength="6" required />
									</div>

									<div class="form-group">
										<label for="acc-confirm-password" class="font-weight-bold">Xác nhận mật khẩu mới <span class="required">*</span></label>
