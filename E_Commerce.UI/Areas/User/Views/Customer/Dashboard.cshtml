										<div class="col-md-6">
											<div class="form-group">
												<label for="acc-lastname">Họ <span class="required">*</span></label>
												<input type="text" class="form-control" id="acc-lastname"
													   name="acc-lastname" required />
											</div>
										</div>
									</div>

									<div class="form-group mb-2">
										<label for="acc-text">Tên hiển thị <span class="required">*</span></label>
										<input type="text" class="form-control" id="acc-text" name="acc-text"
											   readonly />
										<p>
											Tên này sẽ được hiển thị trong khu vực tài khoản và trong đánh giá.
										</p>
									</div>

									<div class="form-group mb-2">
										<label for="acc-email">Email <span class="required">*</span></label>
										<input type="email" class="form-control" id="acc-email" name="acc-email"
											   placeholder="editor@gmail.com" readonly />
									</div>

									<div class="form-group mb-2">
										<label for="acc-phone">Phone <span class="required">*</span></label>
										<input type="tel" class="form-control" id="acc-phone" name="acc-phone"
											   placeholder="0123 456 789" required />
									</div>

									<div class="form-group mb-4">
										<label for="acc-street">Địa chỉ đường <span class="required">*</span></label>
										<input type="text" class="form-control" id="acc-street" name="acc-street"
											   placeholder="Số nhà và tên đường" required />
									</div>

									<div class="form-footer mt-3 mb-0">
										<button type="submit" class="btn btn-dark mr-0">Lưu thay đổi</button>
									</div>
								</form>
							</div>
						</div><!-- End .tab-pane -->


						<div class="tab-pane fade" id="change-password" role="tabpanel">
