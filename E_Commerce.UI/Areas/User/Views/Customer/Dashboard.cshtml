	<!-- Plugins JS File -->
	<script src="~/assets/js/jquery.min.js"></script>
	<script src="~/assets/js/bootstrap.bundle.min.js"></script>
	<script src="~/assets/js/plugins.min.js"></script>

	<!-- Main JS File -->
	<script src="~/assets/js/main.min.js"></script>
	<script src="~/assets/js/cart.js"></script>
	<script>
		let userId = "";
		const itemsPerPage = 5;
		let currentPage = 1;
		const maxVisiblePages = 3;

		const Url = "@ViewBag.ApiBaseUrl";
		document.addEventListener("DOMContentLoaded", async function () {
			try {
				const res = await fetch("https://ecommerceui20250612214226-bvanc5fvcwf5h9gx.canadacentral-01.azurewebsites.net/user/customer/getprofile", {
				credentials: "include"
				});

				const data = await res.json();
				userId = data.id;

				// ✅ Gán tên hiển thị
				document.querySelectorAll("strong.text-dark").forEach(el => el.textContent = data.name);
				await getUserInfo(data.name);

				await renderUserOrdersTable(currentPage);
				await renderUserPagination();

			} catch (err) {
				console.error("Lỗi load profile:", err);
				window.location.href = "/User/Auth/Login";
			}
		});

		async function renderUserOrdersTable(page = 1, searchQuery = "") {
			const url = `${Url}/api/Orders/AllOrder?id=${userId}&page=${page}&pageSize=${itemsPerPage}&searchQuery=${encodeURIComponent(searchQuery)}`;
			try {
				const res = await fetch(url);
				if (!res.ok) throw new Error("Không lấy được đơn hàng");

				const orders = await res.json();
				const tbody = document.querySelector(".table-order tbody");
				tbody.innerHTML = "";

				if (!orders || orders.length === 0) {
					tbody.innerHTML = `
						<tr>
							<td class="text-center p-0" colspan="5">
								<p class="mb-5 mt-5">Bạn chưa có đơn hàng nào.</p>
							</td>
						</tr>`;
					return;
				}

				orders.forEach((order, index) => {
					const date = new Date(order.orderDate).toLocaleDateString("vi-VN");
					const total = Number(order.totalAmount || 0).toLocaleString("vi-VN", { style: "currency", currency: "VND" });

					let statusLabel = "";
					switch (order.status?.toLowerCase()) {
						case "done":
							statusLabel = '<span class="badge bg-success">Thành công</span>'; break;
						case "pending":
							statusLabel = '<span class="badge bg-warning">Chờ xử lý</span>'; break;
						case "cancelled":
							statusLabel = '<span class="badge bg-danger">Đã huỷ</span>'; break;
						default:
							statusLabel = '<span class="badge bg-secondary">Không xác định</span>';
					}

					tbody.innerHTML += `
						<tr>
							<td>#INV-${order.orderId.substring(0, 8).toUpperCase()}</td>
							<td>${date}</td>
							<td>${statusLabel}</td>
							<td>${total}</td>
							<td><button class="btn btn-outline-dark btn-sm" onclick="viewOrderDetail('${order.orderId}')">Chi tiết</button></td>
						</tr>`;
				});

			} catch (err) {
				console.error("Lỗi khi tải đơn hàng:", err);
			}
		}

		async function renderUserPagination() {
			const totalPages = await getUserTotalPages();
			const pagination = document.getElementById("pagination-user");
			pagination.innerHTML = "";

			let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
			let endPage = Math.min(totalPages, currentPage + Math.floor(maxVisiblePages / 2));

			if (endPage - startPage + 1 < maxVisiblePages) {
				if (endPage === totalPages) {
					startPage = Math.max(1, endPage - maxVisiblePages + 1);
				} else {
					endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
				}
			}

			// Prev
			pagination.innerHTML += `
				<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
					<a class="page-link" href="javascript:void(0);" onclick="changeUserPage(${currentPage - 1})">Trước</a>
				</li>`;

			// Numbered pages
			for (let i = startPage; i <= endPage; i++) {
				pagination.innerHTML += `
					<li class="page-item ${i === currentPage ? 'active' : ''}">
						<a class="page-link" href="javascript:void(0);" onclick="changeUserPage(${i})">${i}</a>
					</li>`;
			}

			// Next
			pagination.innerHTML += `
				<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
					<a class="page-link" href="javascript:void(0);" onclick="changeUserPage(${currentPage + 1})">Tiếp</a>
				</li>`;
		}

		async function changeUserPage(page) {
			const totalPages = await getUserTotalPages();
			if (page < 1 || page > totalPages) return;
			currentPage = page;
			await renderUserOrdersTable(currentPage);
			await renderUserPagination();
		}

		async function getUserTotalPages() {
			const url = `${Url}/api/Orders/TotalPagesOrdered_Detail?id=${userId}&pageSize=${itemsPerPage}`;
            console.log(arguments, "URL lấy tổng số trang:", url);
			try {
				const res = await fetch(url);
				const total = await res.json();
				return total > 0 ? total : 1;
			} catch (err) {
				console.error("Lỗi lấy số trang:", err);
				return 1;
			}
		}

		async function viewOrderDetail(orderId) {
		   const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
		   document.getElementById('orderDetailContent').innerHTML = `<p class="text-center">Đang tải dữ liệu...</p>`;
		   modal.show();

		   try {
			 const res = await fetch(`${Url}/api/Orders/OrderDetail/${orderId}`);
			 if (!res.ok) throw new Error("Không thể lấy chi tiết đơn hàng");
			 const data = await res.json();

			 let statusBadge = data.status === "done"
						? `<span class="badge bg-success">Thành công</span>`
						: data.status === "pending"
						? `<span class="badge bg-warning">Chờ xử lý</span>`
						: `<span class="badge bg-danger">Đã huỷ</span>`;

			const itemsHtml = Array.isArray(data.products)
				? data.products.map((item, index) => `
					<tr>
					  <td>${index + 1}</td>
					  <td>${item.name}</td>
					  <td>${item.quantity}</td>
					  <td>${Number(item.price).toLocaleString("vi-VN", { style: "currency", currency: "VND" })}</td>
					</tr>
				  `).join('')
				: `<tr><td colspan="4" class="text-center text-muted">Không có sản phẩm nào trong đơn hàng</td></tr>`;

			 const html = `
			   <p><strong>Mã đơn hàng:</strong> #INV-${data.orderId.substring(0, 8).toUpperCase()}</p>
			   <p><strong>Ngày đặt:</strong> ${new Date(data.orderDate).toLocaleDateString("vi-VN")}</p>
			   <p><strong>Trạng thái:</strong> ${statusBadge}</p>
			   <p><strong>Tổng tiền:</strong> ${Number(data.totalAmount).toLocaleString("vi-VN", { style: "currency", currency: "VND" })}</p>
			   <h5>Danh sách sản phẩm</h5>
			   <table class="table table-bordered">
				 <thead>
				   <tr>
					 <th>#</th>
					 <th>Tên sản phẩm</th>
					 <th>Số lượng</th>
					 <th>Giá</th>
				   </tr>
				 </thead>
				 <tbody>${itemsHtml}</tbody>
			   </table>
			 `;
			 document.getElementById('orderDetailContent').innerHTML = html;

		   } catch (err) {
			 console.error("Lỗi khi tải chi tiết đơn hàng:", err);
			 document.getElementById('orderDetailContent').innerHTML = `<p class="text-danger">Không thể tải chi tiết đơn hàng.</p>`;
		   }
		}

		function fillAccountInfo(data) {
			document.getElementById("acc-name").value = data.firstName || '';
			document.getElementById("acc-lastname").value = data.lastName || '';
			document.getElementById("acc-text").value = data.email || '';
			document.getElementById("acc-email").value = data.email || '';
			document.getElementById("acc-phone").value = data.phoneNumber || '';
			document.getElementById("acc-street").value = data.address || '';
		}

		async function getUserInfo(userName) {
			try {
				const response = await fetch(`${Url}/api/User/${userName}`);
				if (!response.ok) throw new Error("Không lấy được thông tin người dùng");

				const data = await response.json();
				console.log("Thông tin người dùng:", data);

				// Gọi hàm đổ vào form
				fillAccountInfo(data);

			} catch (err) {
				console.error("Lỗi khi gọi API người dùng:", err);
			}
		}

		document.getElementById("account-info-form").addEventListener("submit", async function (e) {
			e.preventDefault(); // chặn submit mặc định

			const dto = {
				userId: userId, 
				firstName: document.getElementById("acc-name").value,
				lastName: document.getElementById("acc-lastname").value,
				phoneNumber: document.getElementById("acc-phone").value,
				address: document.getElementById("acc-street").value,
                email: document.getElementById("acc-email").value,
				gender: true 
			};

			try {
				const res = await fetch(`${Url}/api/UserInfo/${userId}`, {
					method: "PUT",
					headers: {
						"Content-Type": "application/json"
					},
					body: JSON.stringify(dto)
				});

				if (!res.ok) throw new Error("Cập nhật thất bại");

				alert("✅ Cập nhật thông tin thành công!");
				const updatedData = await res.json();
				fillAccountInfo(updatedData); // cập nhật lại form nếu cần

			} catch (err) {
				console.error("❌ Lỗi khi cập nhật thông tin:", err);
				alert("❌ Cập nhật thất bại. Vui lòng thử lại.");
			}
		});

		document.getElementById("change-password-form").addEventListener("submit", async function (e) {
			e.preventDefault();
			const dto = {
				id: userId, 
				currentPassword: document.getElementById("acc-password").value,
				newPassword: document.getElementById("acc-new-password").value,
				confirmPassword: document.getElementById("acc-confirm-password").value
			};

			try {
				const res = await fetch(`${Url}/api/Auth/change-password`, {
					method: "POST",
					headers: {
						"Content-Type": "application/json"
					},
					body: JSON.stringify(dto)
				});

				if (!res.ok) {
					const errorData = await res.json();
					alert("❌ Lỗi: " + (errorData?.errors?.[0] || "Đổi mật khẩu thất bại."));
					return;
				}

				alert("✅ Đổi mật khẩu thành công!");
				document.getElementById("change-password-form").reset();

			} catch (err) {
				console.error("❌ Lỗi khi gọi API đổi mật khẩu:", err);
				alert("❌ Có lỗi xảy ra. Vui lòng thử lại.");
			}
		});
	</script>
</body>

</html>